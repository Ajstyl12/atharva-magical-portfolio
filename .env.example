# ============================================
# HOGWARTS PORTFOLIO — ENVIRONMENT VARIABLES
# ============================================
# Copy this file to `.env` and fill in your values.
#
#   cp .env.example .env
#
# Then restart the dev server (npm run dev).

# ── OWL POST (Contact Form) ──────────────────
# Web3Forms provides FREE, UNLIMITED email forwarding.
# 1. Go to https://web3forms.com
# 2. Enter your email (e.g., atharvabagwe30@gmail.com)
# 3. They'll email you an access key instantly
# 4. Paste it below
#
# When someone fills out the Owl Post form on your site,
# the message will be delivered straight to your email inbox.
VITE_WEB3FORMS_KEY=your_access_key_here

# ── SUPABASE BACKEND ─────────────────────────────────────────────────────
# Powers: Contact form DB, Visitor analytics, Section engagement tracking.
# 1. Go to https://supabase.com and create a project
# 2. Grab your Project URL and anon/public key from Project Settings → API
# 3. Run the migration SQL in supabase/migrations/ on your project
#
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
